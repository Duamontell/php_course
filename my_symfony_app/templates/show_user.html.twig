{% extends 'base.html.twig' %}

{% block title %}Профиль пользователя{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
	div {
		margin-top: 10px;
	}
</style>
{% endblock %}

{% block body %}
<h1>Профиль пользователя</h1>

<form action="{{userId}}/edit" enctype="multipart/form-data" method="POST">
	<div>
		<label for="first_name-input">Имя: </label>
		<input
			type="text"
			id="first_name-input"
			name="first_name"
			value="{{ user.firstName }}"
			maxlength="50"
			required>
	</div>

	<div>
		<label for="last_name-input">Фамилия:</label>
		<input
			type="text"
			id="last_name-input"
			name="last_name"
			value="{{ user.lastName }}"
			maxlength="50"
			required>
	</div>

	<div>
		<label for="middle_name-input">Отчество:</label>
		<input
			type="text"
			id="middle_name-input"
			name="middle_name"
			value="{{ user.middleName }}"
			maxlength="50">
	</div>

	<div>
		<label for="gender-select">Пол: </label>
		<select name="gender" id="gender-select">
			{% for key, label in {'man': 'Мужской', 'woman': 'Женский'} %}
			<option value="{{ key }}" {% if user.gender == key %}selected{% endif %}>
				{{ label }}
			</option>
			{% endfor %}
		</select>
	</div>

	<div>
		<label for="birth_date-input">Дата рождения</label>
		<input
			type="date"
			id="birth_date-input"
			name="birth_date"
			value="{{ birthDate }}"
			required>
	</div>

	<div>
		<label for="email-input">Email</label>
		<input
			type="email"
			id="email-input"
			name="email"
			value="{{ user.email }}"
			maxlength="50"
			required>
	</div>

	<div>
		<label for="phone-input">Телефон</label>
		<input
			type="tel"
			id="phone-input"
			name="phone"
			value="{{ user.phone }}"
			maxlength="20">
	</div>

	<div>
		<label for="avatar-input">Аватар</label>
		<input
			type="file"
			id="avatar-input"
			name="avatar"
			accept=".png, .jpeg, .gif">
	</div>

	{% if user.avatarPath is not empty %}
	<img
		src="/uploads/{{ user.avatarPath }}"
		width="100"
		style="display: block;"
		alt="Аватар пользователя">
	{% endif %}

	<button type="submit">Обновить данные</button>
</form>

<form action="{{ userId }}/delete" method="POST">
	<button type="submit">Удалить аккаунт</button>
</form>

{% block javascripts %}
{{ parent() }}
<script>
	document.getElementById("phone-input").addEventListener("keypress", function(e) {
		if (!/[0-9]/.test(e.key)) {
			e.preventDefault();
		}
	});
</script>
{% endblock %}
{% endblock %}